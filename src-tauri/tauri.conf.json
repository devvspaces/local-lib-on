{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Local Lib",
  "version": "0.1.0",
  "identifier": "com.locallib.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Local Lib",
        "width": 1320,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**",
          "$HOME/Downloads/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "pdf"
        ],
        "mimeType": "application/pdf",
        "role": "Viewer"
      },
      {
        "ext": [
          "epub"
        ],
        "mimeType": "application/epub+zip",
        "role": "Viewer"
      }
    ],
    "createUpdaterArtifacts": true,
    "category": "Productivity",
    "shortDescription": "Local-first book library and reader",
    "longDescription": "Organize, read, annotate and study your books and papers, offline-first, with sync, citations and on-device AI tools.",
    "copyright": "Copyright © 2026 Local Lib contributors",
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0",
      "entitlements": "./Entitlements.plist"
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libasound2"
        ]
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/devvspaces/local-lib-on/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ1QkMzNEYwOUZDMTQ2Q0EKUldUS1JzR2Y4RFM4UmFuQzdwdmdyKzNqUGFtYSsvMFRMZ0NoMXl3TVlwR25DU1FPYXFldzNOVmoK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
