{
  "manifest_version": 3,
  "name": "Save to Local Lib",
  "version": "0.1.0",
  "description": "Save the paper or book you're viewing (DOI, arXiv, ISBN, open-access PDF) into your Local Lib library.",
  "action": { "default_popup": "popup.html", "default_title": "Save to Local Lib" },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1:23120/*"],
  "icons": { "128": "icon128.png" },
  "browser_specific_settings": { "gecko": { "id": "save@local-lib.app" } }
}
